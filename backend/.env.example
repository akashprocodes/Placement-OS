PROJECT_NAME="Placement OS API"
ENVIRONMENT="development"  # set to "production" in staging/production to enforce secure secrets

# CORS allowed origins (comma-separated for multiple origins, e.g. "https://staging.placementos.com,http://localhost:3000")
FRONTEND_URL="http://localhost:3000"

# YouTube Data API v3 Key (required for real-time video/playlist search and metadata retrieval)
YOUTUBE_API_KEY="your_youtube_api_key_here"

# Database Connection (PostgreSQL with asyncpg driver)
# Local Docker development:
DATABASE_URL="postgresql+asyncpg://placement_os:placement_os_dev@localhost:5434/placement_os"
# Hosted Neon Serverless PostgreSQL (free-tier staging/production with SSL):
# Note: Use postgresql+asyncpg:// and append ?ssl=require for asyncpg TLS handshake
# DATABASE_URL="postgresql+asyncpg://<username>:<password>@<ep-hostname>.neon.tech/<dbname>?ssl=require"

# JWT Authentication
# In production (ENVIRONMENT=production), JWT_SECRET_KEY must be a cryptographically secure secret at least 32 characters long
JWT_SECRET_KEY="replace-this-with-a-secure-secret-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

