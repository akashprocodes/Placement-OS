# Placement OS Web - Environment Variables Template

# Backend Server URL (used by Next.js SSR, Route Handlers, and Next.js /api/v1 rewrite proxy)
# In production on Vercel/hosting, set this to your hosted backend (e.g. "https://placement-os-backend.onrender.com")
BACKEND_URL="http://localhost:8000"

# Public Client-Side Backend URL
# Leave empty ("") to route browser API requests through the Next.js /api/v1 rewrite proxy.
# Using the same-origin proxy ensures HttpOnly authentication cookies are forwarded seamlessly
# without cross-site cookie blocking or CORS preflight failures across disjoint cloud domains.
# Only set to an absolute URL if you explicitly intend to bypass the Next.js rewrite proxy.
NEXT_PUBLIC_BACKEND_URL=""

# Node Environment
# Set to "production" in staging/production to enforce secure HttpOnly session cookies over HTTPS
NODE_ENV="development"

