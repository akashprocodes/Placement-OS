# Placement OS Web - Environment Variables Template

# Internal Server-Side Backend URL (used by Next.js SSR and API Route Handlers)
BACKEND_URL="http://localhost:8000"

# Public Client-Side Backend URL (used by browser client fetches)
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"

# Node Environment
# Set to "production" in staging/production to enforce secure HttpOnly session cookies
NODE_ENV="development"

